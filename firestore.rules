rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) 
        && data.keys().size() <= 6
        && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.createdAt == request.time
        && (data.name == null || (data.name is string && data.name.size() <= 100))
        && (data.avatar == null || (data.avatar is string && data.avatar.size() <= 500));
    }

    function isValidUserUpdate(data) {
      return data.userId == request.auth.uid
        && data.updatedAt == request.time
        && (data.name == null || (data.name is string && data.name.size() <= 100))
        && (data.avatar == null || (data.avatar is string && data.avatar.size() <= 500));
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['userId', 'updatedAt'])
        && data.keys().size() <= 4
        && data.userId == request.auth.uid
        && data.updatedAt == request.time
        && (data.theme == null || data.theme in ['light', 'dark'])
        && (data.currency == null || data.currency in ['PKR', 'INR', 'USD']);
    }

    // --- Collection Routes ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && isValidUserUpdate(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'updatedAt']);

      match /settings/config {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSetting(incoming());
      }
    }
    
    // Connection test document
    match /test/connection {
      allow get: if true;
    }
  }
}
